# Postgres connection string (Neon, Supabase, Vercel Postgres, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/the_studio"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"

# Anthropic API key powers every AI role (Researcher, Designer, Copywriter, Social Manager, Data Analyst)
ANTHROPIC_API_KEY=""
# Optional override; defaults to claude-sonnet-5 if unset
ANTHROPIC_MODEL=""

# Seeds the one founder account on `npm run db:seed` — required to log in
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-strong-password"
